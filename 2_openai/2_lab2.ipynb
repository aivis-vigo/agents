    "\n",
    "USE_EMAIL = EMAIL_ADDRESS and EMAIL_SMTP_SERVER and EMAIL_APP_PASSWORD\n",
    "\n",
    "if USE_EMAIL:\n",
    "    print(\"Email is set up and we will try using it\")\n",
    "else:\n",
    "    print(\"Email is not set up; we will send push notifications instead\")"
