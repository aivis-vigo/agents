   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def send_message(subject, text_body, html_body):\n",
    "    if USE_EMAIL:\n",
    "        send_email(subject, text_body, html_body)\n",
    "    else:\n",
    "        push(f\"Subject: {subject}\\n\\n{text_body}\")"
   ]
